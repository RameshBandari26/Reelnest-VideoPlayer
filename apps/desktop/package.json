{
  "name": "@lumo/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env LUMO_DEV=1 electron .\"",
    "build": "vite build",
    "test": "node --test test/*.test.cjs",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "@lumo/core": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.reelnest.player",
    "productName": "Reelnest",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Reelnest-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Reelnest-mac.${ext}",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "Reelnest-linux.${ext}",
      "category": "AudioVideo"
    }
  },
  "description": "Reelnest video and music player",
  "author": "Reelnest"
}