{
  "expo": {
    "name": "Lumo",
    "slug": "lumo-player",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "app.lumo.player",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.lumo.player",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Lumo needs access to play your videos.",
          "granularPermissions": [
            "audio",
            "video"
          ]
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7b98a35d-4c8e-42cc-8162-dfee9cab4cbd"
      }
    }
  }
}
