{
  "expo": {
    "name": "Reelnest",
    "slug": "lumo-player",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "app.reelnest.player",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#241c58" }
    },
    "ios": {
      "bundleIdentifier": "app.reelnest.player",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Reelnest needs access to play your videos.",
          "granularPermissions": [
            "audio",
            "video"
          ]
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ]
  }
}